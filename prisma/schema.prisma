// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Edition {
  id               Int           @id @default(autoincrement())
  year             Int           @unique
  editionNumber    Int
  eventDate        DateTime
  isCurrent        Boolean       @default(false)
  registrationUrl  String?
  resultsUrl       String?
  galleryUrl       String?
  propositionsHtml String?
  infoHtml         String?
  registrationOpen Boolean       @default(false)
  registrationHtml String?
  heroTitle        String?
  routes           Route[]
  stats            EditionStat[]
}

model Route {
  id          Int     @id @default(autoincrement())
  editionId   Int
  edition     Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  name        String
  distanceKm  Float
  elevationM  Int?
  gpxUrl      String?
  mapEmbedUrl String?

  @@index([editionId])
}

model EditionStat {
  id        Int     @id @default(autoincrement())
  editionId Int
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  label     String
  value     String
  order     Int     @default(0)

  @@index([editionId])
}

// Sponsors are one global list shared by all editions
model Sponsor {
  id      Int     @id @default(autoincrement())
  name    String
  logoUrl String?
  webUrl  String?
  order   Int     @default(0)
}

model Photo {
  id       Int     @id @default(autoincrement())
  url      String
  alt      String
  order    Int     @default(0)
  isActive Boolean @default(true)
}
