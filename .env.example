# Shared password for the /admin area, compared in constant time on login
ADMIN_PASSWORD=

# Secret for signing the admin session cookie, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# SQLite database file; the default is for local development. On Coolify use file:/data/app.db
# DATABASE_URL=file:./dev.db

# Folder for uploaded images; the default is for local development. On Coolify use /data/uploads
# UPLOADS_DIR=./uploads

# Request body limit, read by adapter-node in production (its default is 512K, too small for a 5 MB photo)
# BODY_SIZE_LIMIT=6M
